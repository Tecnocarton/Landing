# Resend Email Service
RESEND_API_KEY="your_resend_api_key_here"

# Redis (opcional) — correlativo de cotizaciones.
# Sin esto se usa un archivo local (.quote-counter) como fallback.
REDIS_URL="redis://localhost:6379"

# Registro de cotizaciones en Google Sheets (ver docs/google-sheets-cotizaciones.md).
# Sin SHEETS_WEBHOOK_URL el registro es no-op: el sitio funciona igual, solo no escribe.
SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/XXXXXXXX/exec"
SHEETS_WEBHOOK_SECRET="el_mismo_secreto_del_apps_script"

# Asistente de cajas de stock (BoxFinder) — función en BETA.
# Solo con el valor exacto "true" se muestran /cajas-stock y el flujo de sugerencia.
# En producción NO definir esta variable hasta validar la función.
NEXT_PUBLIC_ENABLE_BOXFINDER_BETA="true"

# Fichas técnicas (/productos, /productos/[slug]) y catálogo (/catalogo) — en BETA.
# Contenido técnico todavía en revisión: solo con el valor exacto "true" existen
# esas rutas y aparecen sus enlaces en el header y el footer. En producción NO
# definir esta variable hasta cerrar la revisión de gramajes, ondas y tolerancias.
NEXT_PUBLIC_ENABLE_FICHAS_BETA="true"

# Google Tag Manager
NEXT_PUBLIC_GTM_ID="GTM-W5VXBNHX"

# Google Ads Conversion Tracking
# ID de conversión de Google Ads (formato: AW-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID="AW-17883826137"

# Google Analytics 4 (gtag directo; Firebase ya no se usa).
# app/layout.js acepta el nombre viejo NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID como fallback.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
